@model FaceKid.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h2 class="text-center mb-4">FaceKid - Kayıt Ol</h2>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                <div asp-validation-summary="All"></div>

                        <div class="mb-3">
                    <label asp-for="FullName">Ad Soyad</label>
                            <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName"></span>
                </div>

                        <div class="mb-3">
                    <label asp-for="Email">E-posta</label>
                            <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email"></span>
                </div>

                        <div class="mb-3">
                    <label asp-for="Password">Şifre</label>
                            <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password"></span>
                </div>

                        <div class="mb-3">
                    <label asp-for="ConfirmPassword">
                        Şifre Tekrar
                    </label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                        <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
            </form>

            <p class="text-center mt-3">Zaten hesabın var mı?</p>
            <a asp-controller="Account" asp-action="Login">Giriş Yap</a>

        </div>
    </div>
</div>