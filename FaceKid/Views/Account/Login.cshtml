@model FaceKid.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <h2 class="text-center mb-4">FaceKid - Giriş Yap</h2>

    <!-- Login POST action'ına veri gönderir. -->
    <form asp-controller="Account"
          asp-action="Login"
          method="post">

        <!-- ModelState hatalarını gösterir. -->
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
            <label asp-for="Email">E-posta</label>
                    <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"></span>
        </div>

                <div class="mb-3">
            <label asp-for="Password">Şifre</label>
                    <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password"></span>
        </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-control" />
            <label asp-for="RememberMe">
                Beni Hatırla
            </label>
        </div>

                <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
    </form>

            <p class="mt-3">
                Hesabın yok mu?
                <a asp-controller="Account"
                   asp-action="Register">
                    Kayıt Ol
                </a>
            </p>


        </div>
    </div>
</div>