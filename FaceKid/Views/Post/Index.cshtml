@model FaceKid.ViewModels.PostIndexViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Postlar";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h2 class="text-center mb-4">Facekid</h2>

            <p class="text-center mt-3">Hoşgeldin, @User.Identity?.Name!</p>

<!-- yeni post oluşturma formu-->

<form asp-controller="Post" asp-action="Create" method="post" >
    @Html.AntiForgeryToken()

                <div class="mb-3">
        <label asp-for="NewPost.Content">
            Ne düşünüyorsun?
        </label>
        <br/>
                    <textarea asp-for="NewPost.Content" rows="4" cols="50" maxlength="500" class="form-control">
        </textarea>
        <!--Fluent validation hata mesajları-->
        <span asp-validation-for="NewPost.Content" style="color:red"></span>
    </div>
                <button type="submit" class="btn btn-primary w-100">Paylaş!</button>

</form>

<hr/>

            <h3 class="text-center mb-4">Paylaşımlar</h3>

<!--Post listesi-->

<div id="postList">

                @if (Model.Posts.Count == 0)
                {
                    <p>Henüz post yok!</p>
                }
                else
                {
                    @foreach (var post in Model.Posts)
                    {
                        <div class="mb-3">
                            <strong>@post.User.FullName</strong>
                            <small>@post.SentAt.ToLocalTime().ToString("dd.MM.yyy HH.mm")</small>
                            <p>@post.Content</p>
                        </div>
                        <hr />
                    }
                }

</div>

        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary w-100" style="background-color:red">Çıkış yap!</button>

        </form>
        </div>    
        </div>
</div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js">

</script>

<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/postHub").withAutomaticReconnect().build();

    connection.on("ReceivePost", function(post){
        const postList = document.getElementById("postList");

        const emptyMessage = document.getElementById("emptyMessage");

        if(emptyMessage){
            emptyMessage.remove();
        }

        const postDiv = document.createElement("div");
        const username = document.createElement("strong");
        username.textContent = post.fullName || "Kullanıcı";
        const date = document.createElement("small");
        date.textContent = " " + new Date(post.sentAt).toLocaleString("tr-TR");
        const content = document.createElement("p");
        content.textContent = post.content;

        postDiv.appendChild(username);
        postDiv.appendChild(date);
        postDiv.appendChild(content);

        const hr = document.createElement("hr");

        postList.prepend(hr);
        postList.prepend(postDiv);


    });

    async function startConnection(){
        try{
            await connection.start();
            console.log("SignalR bağlantısı kuruldu!");
        }catch(error){
            console.error("SignalR bağlantı hatası", error;
        }
    }
    startConnection();
</script>